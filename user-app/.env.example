# Flask Configuration
FLASK_PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000

# CLIP Model
CLIP_DEVICE=auto
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Qdrant
QDRANT_STORAGE_PATH=../qdrant_storage
QDRANT_COLLECTION_NAME=image_search
QDRANT_VECTOR_SIZE=512

# Icelandic Support
ENABLE_ICELANDIC_TRANSLATION=true
