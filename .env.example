# =============================================================================
# SAGA REYKJAVÍK IMAGE SEARCH - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your values

# -----------------------------------------------------------------------------
# Flask Web Server Configuration
# -----------------------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=your-secret-key-here-change-in-production

# -----------------------------------------------------------------------------
# Indexing Service Configuration (FastAPI)
# -----------------------------------------------------------------------------
INDEXING_SERVICE_HOST=0.0.0.0
INDEXING_SERVICE_PORT=8001
INDEXING_SERVICE_WORKERS=1

# -----------------------------------------------------------------------------
# CLIP Model Configuration
# -----------------------------------------------------------------------------
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
CLIP_DEVICE=auto  # Options: auto, cuda, cpu
CLIP_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=image_search
QDRANT_VECTOR_SIZE=512
QDRANT_DISTANCE_METRIC=Cosine

# -----------------------------------------------------------------------------
# Image Indexing Configuration
# -----------------------------------------------------------------------------
DEFAULT_IMAGE_FOLDER=./scraped_images
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,webp
INDEX_BATCH_SIZE=100
MAX_CONCURRENT_INDEXING_JOBS=3

# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------
DEFAULT_SEARCH_LIMIT=50
MIN_SIMILARITY_SCORE=0.0
MAX_SEARCH_RESULTS=200

# Hybrid search weights
TEXT_SEARCH_WEIGHT=0.7
METADATA_SEARCH_WEIGHT=0.3

# -----------------------------------------------------------------------------
# Icelandic Language Support
# -----------------------------------------------------------------------------
ENABLE_ICELANDIC_TRANSLATION=true
TRANSLATION_FALLBACK=true
SUPPORTED_LANGUAGES=is,en
DEFAULT_LANGUAGE=is

# -----------------------------------------------------------------------------
# Redis Configuration (for Celery job queue)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery broker URL
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Audit & Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/app.log
ENABLE_AUDIT_LOG=true
AUDIT_LOG_FILE=./logs/audit.log
MAX_LOG_SIZE_MB=100
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# File Upload & Storage
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
TEMP_UPLOAD_DIR=./temp_uploads
ENABLE_FILE_CLEANUP=true
CLEANUP_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
VITE_INDEXING_API_BASE_URL=http://localhost:8001
VITE_APP_TITLE=Saga Reykjavík Image Search
VITE_THEME_PRIMARY_COLOR=#5ac8fa
VITE_THEME_ACCENT_COLOR=#af52de

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Security & Authentication (Future)
# -----------------------------------------------------------------------------
ENABLE_AUTH=false
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# -----------------------------------------------------------------------------
# Performance & Optimization
# -----------------------------------------------------------------------------
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
MAX_WORKERS=4
ENABLE_GPU=auto

# -----------------------------------------------------------------------------
# Web Scraper Configuration
# -----------------------------------------------------------------------------
SCRAPER_SOURCE_URL=https://borgarsogusafn.is/myndasafn
SCRAPER_OUTPUT_DIR=./scraped_images
SCRAPER_MAX_IMAGES=1000
SCRAPER_DELAY_MS=500
